{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "boreal": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "coverage": true,
            "coverageReporters": ["text-summary", "lcov"],
            "coverageInclude": [
              "src/app/features/payments/payment-api.ts",
              "src/app/features/subscriptions/subscription-api.ts"
            ]
          }
        },
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/boreal",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "public" }]
          },
          "configurations": {
            "production": {
              "budgets": [{ "type": "initial", "maximumWarning": "650kB", "maximumError": "900kB" }],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "boreal:build:production" },
            "development": { "buildTarget": "boreal:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
