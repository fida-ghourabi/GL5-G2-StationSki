# cp terraform.tfvars.example terraform.tfvars
region             = "us-east-1"
kubernetes_version = "1.33"

# AWS Academy Learner Lab => false (utilise LabRole). Compte AWS classique => true
create_iam_roles   = false
existing_role_name = "LabRole"

node_instance_type = "t3.medium"
node_capacity_type = "ON_DEMAND" # "SPOT" pour economiser si autorise
node_desired_size  = 1

# Remplace par ton IP publique : curl ifconfig.me
allowed_cidrs = ["0.0.0.0/0"]
